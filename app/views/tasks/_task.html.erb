<li class="task-item">
  <div class="task-main">
    <%= form_with model: task do |form| %>
      <% if local_assigns[:status].present? %>
        <%= hidden_field_tag :status, status %>
      <% end %>

      <%= form.check_box :completed, checked: task.completed, onchange: "this.form.requestSubmit();" %>
    <% end %>

    <span class="task-title <%= 'is-completed' if task.completed? %>">
      <%= task.title %>
    </span>

    <span class="status-badge <%= task.completed? ? 'is-completed' : 'is-pending' %>">
      <%= task.completed? ? "Completed" : "Pending" %>
    </span>
  </div>

  <div class="task-actions">
    <%= link_to "Edit", edit_task_path(task) %>
    <%= button_to "Delete", task_path(task), method: :delete, params: { status: status }, form: { data: { turbo_confirm: "Delete this task?" } } %>
  </div>
</li>