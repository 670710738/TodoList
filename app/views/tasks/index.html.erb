<h1>Todo List</h1>

<%= render "form", task: @task %>

<h2>All Tasks</h2>

<% if @tasks.any? %>
  <ul>
    <% @tasks.each do |task| %>
      <li>
        <%= form_with model: task, local: true do |form| %>
          <%= form.check_box :completed, checked: task.completed, onchange: "this.form.requestSubmit();" %>
          <% if task.completed? %>
            <s><%= task.title %></s>
          <% else %>
            <%= task.title %>
          <% end %>
        <% end %>

        <%= link_to "Edit", edit_task_path(task) %>
        <%= button_to "Delete", task_path(task), method: :delete, form: { data: { turbo_confirm: "Delete this task?" } } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No tasks yet.</p>
<% end %>
